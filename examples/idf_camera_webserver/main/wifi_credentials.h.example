/*
 * Template for the demo Wi-Fi credentials.
 *
 * Copy this file to wifi_credentials.h and fill in your own network:
 *
 *     cp main/wifi_credentials.h.example main/wifi_credentials.h
 *
 * wifi_credentials.h is gitignored, so real credentials stay out of version
 * control. If it is missing the demo still builds - the button press simply
 * reports that no network is configured.
 */
#pragma once

#define DEMO_WIFI_SSID      "your-ssid"
#define DEMO_WIFI_PASSWORD  "your-password"
