/*
 * Optional local overrides. Wi-Fi is never read from here - it lives in NVS,
 * set via the provisioning portal (main/portal/) or the ClearWifi button
 * gesture. This file only matters if you want to point at a self-hosted
 * TRMNL server instead of trmnl.app.
 *
 * Copy this file to trmnl_credentials.h to use it; the copy is .gitignore'd
 * so it never reaches the repository. If you don't need the override, you
 * don't need this file at all.
 */

#ifndef TRMNL_CREDENTIALS_H
#define TRMNL_CREDENTIALS_H

/* Override to point at a self-hosted TRMNL server. Leave undefined to use
 * TRMNL_API_BASE_URL from trmnl_config.h (https://trmnl.app). */
/* #define TRMNL_API_BASE_URL_OVERRIDE "http://192.168.1.10:2300" */

#endif /* TRMNL_CREDENTIALS_H */
